{
  "name": "lexiguard-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LexiGuard AI — Next-Generation Contract Risk Auditing, Redline Diff & Legal Access Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run --prefix frontend dev",
    "dev:backend": "npm run --prefix backend dev",
    "build": "npm run --prefix frontend build",
    "test": "npm run --prefix frontend test && npm run --prefix backend test",
    "test:frontend": "npm run --prefix frontend test",
    "test:backend": "npm run --prefix backend test",
    "preview": "npm run --prefix frontend preview",
    "migrate": "npm run --prefix backend migrate",
    "seed": "npm run --prefix backend seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
