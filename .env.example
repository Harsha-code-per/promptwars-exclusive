# Google Gemini API Key for Live GenAI Features
# (Application also operates with offline Deterministic Legal NLP Heuristic Fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# NOTE FOR VERCEL DEPLOYMENT:
# In Vercel Project Settings -> Environment Variables:
# Because Vite bundles client-side variables prefixed with VITE_, Vercel prevents saving them as "Secret".
# Select the "Config" radio button (instead of "Secret") when adding VITE_GEMINI_API_KEY in Vercel.

